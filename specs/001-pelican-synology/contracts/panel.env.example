# ===========================================
# Pelican Panel - Configuration Environment
# ===========================================
# Ce fichier est généré automatiquement lors de l'installation.
# Les valeurs entre {{}} sont remplacées par le wizard d'installation.

# --- Package Wiring (Ne pas modifier) ---
COMPOSE_PROJECT_NAME=pelican_panel
DATA_ROOT=/var/packages/pelican_panel/var/data

# --- Docker Images ---
PANEL_IMAGE=ghcr.io/pelican-dev/panel:latest

# --- Application Settings ---
APP_ENV=production
APP_DEBUG=false
APP_URL={{wizard_app_url}}
APP_LOCALE={{wizard_locale}}
APP_TIMEZONE=Europe/Paris

# --- Ports ---
PANEL_PORT={{wizard_port}}
PANEL_HTTPS_PORT=8443

# --- Admin Account ---
ADMIN_EMAIL={{wizard_admin_email}}

# --- Session & Cookies ---
# Mettre à 'true' si vous utilisez un reverse proxy HTTPS
SESSION_SECURE_COOKIE=false

# --- Proxy Settings ---
# '*' pour accepter tous les proxies (reverse proxy DSM)
TRUSTED_PROXIES=*

# --- Mail Settings (Optionnel) ---
# Configurable via le panneau d'administration après installation
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ===========================================
# Wings Settings (Après configuration Panel)
# ===========================================
# Ces valeurs sont obtenues après création du Node dans le Panel
WINGS_FQDN=
WINGS_TOKEN_ID=
WINGS_TOKEN=
WINGS_PANEL_URL={{wizard_app_url}}
WINGS_CONFIG_PATH=/var/packages/pelican_panel/var/data/wings/config.yml
